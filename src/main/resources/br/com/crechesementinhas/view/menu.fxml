<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.crechesementinhas.controller.MenuController"
            prefWidth="900" prefHeight="600"
            stylesheets="@estilo.css"
            style="-fx-background-color: #f4f6f9;">

    <!-- Barra superior: título, usuário logado e botão Sair -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #2e7d32;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Creche Sementinhas"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelUsuario" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button text="Sair" onAction="#sair"
                    style="-fx-background-color: white; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Centro: um botão para cada frente do grupo -->
    <center>
        <VBox alignment="CENTER" spacing="25">
            <Label text="O que você deseja fazer?"
                   style="-fx-font-size: 18px; -fx-text-fill: #37474f;"/>

            <TilePane alignment="CENTER" hgap="20" vgap="20" prefColumns="3" maxWidth="740">
                <Button text="Nova Matrícula" onAction="#novaMatricula"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
                <Button text="Consultar Alunos" onAction="#consultarAlunos"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
                <Button text="Responsáveis" onAction="#responsaveis"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
                <Button text="Ficha de Anamnese" onAction="#anamnese"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
                <Button text="Contratos e Documentos" onAction="#contratos"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
                <Button text="Turmas" onAction="#turmas"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
                <!-- Visível apenas para o perfil Suporte (RNF-03) -->
                <Button fx:id="botaoUsuarios" text="Usuários" onAction="#usuarios"
                        styleClass="botao-menu" prefWidth="220" prefHeight="90"/>
            </TilePane>
        </VBox>
    </center>
</BorderPane>