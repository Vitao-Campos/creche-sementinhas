<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tela inicial: menu lateral à esquerda (cerca de 20% da largura) e logo ao centro -->
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.crechesementinhas.controller.MenuController"
            prefWidth="1000" prefHeight="650"
            stylesheets="@estilo.css"
            styleClass="fundo-inicio">

    <!-- Menu lateral -->
    <left>
        <VBox fx:id="barraLateral" styleClass="barra-lateral" spacing="8"
              minWidth="190" maxWidth="280" prefWidth="220">
            <padding>
                <Insets top="22" right="16" bottom="18" left="16"/>
            </padding>

            <Label text="Creche Sementinhas" styleClass="titulo-lateral" wrapText="true"/>
            <Label text="MENU" styleClass="rotulo-secao"/>

            <Button text="Nova Matrícula" onAction="#novaMatricula" styleClass="botao-lateral" maxWidth="Infinity"/>
            <Button text="Alunos" onAction="#consultarAlunos" styleClass="botao-lateral" maxWidth="Infinity"/>
            <Button text="Responsáveis" onAction="#responsaveis" styleClass="botao-lateral" maxWidth="Infinity"/>
            <Button text="Ficha de Anamnese" onAction="#anamnese" styleClass="botao-lateral" maxWidth="Infinity"/>
            <Button text="Contratos e Documentos" onAction="#contratos" styleClass="botao-lateral" maxWidth="Infinity"/>
            <Button text="Turmas" onAction="#turmas" styleClass="botao-lateral" maxWidth="Infinity"/>
            <!-- Visível apenas para o perfil Suporte -->
            <Button fx:id="botaoUsuarios" text="Usuários" onAction="#usuarios"
                    styleClass="botao-lateral" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="labelUsuario" styleClass="usuario-lateral" wrapText="true"/>
            <Button text="Sair" onAction="#sair" styleClass="botao-sair" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Centro: emblema e nome da creche -->
    <center>
        <VBox fx:id="areaLogo" alignment="TOP_CENTER" spacing="22">
            <padding>
                <Insets top="60" right="20" bottom="20" left="20"/>
            </padding>
            <ImageView fx:id="imagemEmblema" fitWidth="300" fitHeight="300"
                       preserveRatio="true" smooth="true" styleClass="emblema">
                <image>
                    <Image url="@../imagens/emblema.png"/>
                </image>
            </ImageView>
            <ImageView fx:id="imagemNome" fitWidth="360" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../imagens/nome-sementinhas.png"/>
                </image>
            </ImageView>
        </VBox>
    </center>
</BorderPane>
