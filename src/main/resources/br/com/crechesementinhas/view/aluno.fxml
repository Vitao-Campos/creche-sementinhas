<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.crechesementinhas.controller.AlunoController"
            prefWidth="1180" prefHeight="720"
            stylesheets="@estilo.css"
            styleClass="fundo-tela">

    <!-- Barra superior: título e volta para o menu -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="barra-topo">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Alunos"
                   styleClass="titulo-topo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar ao menu" onAction="#voltar"
                    styleClass="botao-topo"/>
        </HBox>
    </top>

    <!-- Esquerda: busca e lista de alunos -->
    <left>
        <VBox spacing="10" prefWidth="440">
            <padding>
                <Insets top="20" right="10" bottom="20" left="20"/>
            </padding>
            <Label text="Buscar aluno pelo nome" styleClass="texto-forte"/>
            <TextField fx:id="campoBusca" promptText="Digite parte do nome"/>
            <TableView fx:id="tabelaAlunos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaNome" text="Nome" prefWidth="160"/>
                    <TableColumn fx:id="colunaNascimento" text="Nascimento" prefWidth="90"/>
                    <TableColumn fx:id="colunaIdade" text="Idade" prefWidth="100"/>
                    <TableColumn fx:id="colunaCpf" text="CPF" prefWidth="100"/>
                </columns>
            </TableView>
            <Label fx:id="labelTotal" styleClass="texto-suave"/>
        </VBox>
    </left>

    <!-- Centro: formulário de cadastro e edição -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-transparente">
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="10"/>
            </padding>

            <Label fx:id="labelTituloForm" text="Novo aluno"
                   styleClass="titulo-secao-grande"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" prefWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nome *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nascimento *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="campoNascimento" editable="true" promptText="dd/mm/aaaa"
                            maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Idade" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="labelIdade" text="—" styleClass="texto-forte"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Sexo *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboSexo" maxWidth="Infinity"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="CPF (se tiver)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="campoCpf" promptText="000.000.000-00"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Naturalidade" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNaturalidade" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Nacionalidade" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNacionalidade" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Observações" GridPane.rowIndex="7" GridPane.columnIndex="0"
                       GridPane.valignment="TOP"/>
                <TextArea fx:id="campoObservacao" prefRowCount="3" wrapText="true"
                          GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label fx:id="rotuloJustificativa" text="Motivo da alteração"
                       GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="campoJustificativa" promptText="Opcional: vai para o histórico"
                           GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="labelMensagem" wrapText="true" visible="false" managed="false"/>

            <HBox spacing="10">
                <Button fx:id="botaoSalvar" text="Salvar" defaultButton="true" onAction="#salvar"
                        styleClass="botao-primario"/>
                <Button fx:id="botaoNovo" text="Novo aluno" onAction="#novoAluno"
                        styleClass="botao-secundario"/>
                <Button fx:id="botaoHistorico" text="Ver histórico de alterações" onAction="#verHistorico"
                        styleClass="botao-neutro"/>
            </HBox>

            <Separator/>

            <!-- Ficha: responsáveis, responsável financeiro e pessoas autorizadas (RF-02, RN-01 a RN-04) -->
            <VBox fx:id="painelFicha" spacing="8">
                <Label text="Responsáveis"
                       styleClass="titulo-secao"/>
                <Label fx:id="labelResumoLegal" wrapText="true" styleClass="texto-forte"/>
                <Label fx:id="labelResumoFinanceiro" wrapText="true" styleClass="texto-forte"/>

                <TableView fx:id="tabelaResponsaveisAluno" prefHeight="130" minHeight="130">
                    <columns>
                        <TableColumn fx:id="colunaRespNome" text="Nome" prefWidth="150"/>
                        <TableColumn fx:id="colunaRespParentesco" text="Parentesco" prefWidth="85"/>
                        <TableColumn fx:id="colunaRespLegal" text="Legal" prefWidth="50"/>
                        <TableColumn fx:id="colunaRespFinanceiro" text="Financeiro" prefWidth="72"/>
                        <TableColumn fx:id="colunaRespTelefone" text="Telefone" prefWidth="105"/>
                        <TableColumn fx:id="colunaRespSituacao" text="Situação" prefWidth="100"/>
                    </columns>
                </TableView>
                <Label wrapText="true" styleClass="texto-suave"
                       text="Para vincular ou encerrar responsáveis (inclusive quem paga a mensalidade), use a tela Responsáveis do menu."/>

                <Label text="Pessoas autorizadas a buscar a criança"
                       styleClass="titulo-secao titulo-secao-espaco"/>
                <TableView fx:id="tabelaAutorizados" prefHeight="130" minHeight="130">
                    <columns>
                        <TableColumn fx:id="colunaAutNome" text="Nome" prefWidth="140"/>
                        <TableColumn fx:id="colunaAutRg" text="RG" prefWidth="90"/>
                        <TableColumn fx:id="colunaAutTelefone" text="Telefone" prefWidth="105"/>
                        <TableColumn fx:id="colunaAutParentesco" text="Parentesco" prefWidth="80"/>
                        <TableColumn fx:id="colunaAutTipo" text="Autoriza" prefWidth="110"/>
                        <TableColumn fx:id="colunaAutSituacao" text="Situação" prefWidth="60"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button fx:id="botaoRetirar" text="Retirar autorização selecionada" onAction="#retirarAutorizacao"
                            styleClass="botao-perigo-contorno"/>
                </HBox>

                <Label text="Autorizar nova pessoa" styleClass="texto-forte texto-espaco-6"/>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="130"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Nome *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoAutNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="RG *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoAutRg" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Telefone *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoAutTelefone" promptText="(00) 00000-0000"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Parentesco" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="comboAutParentesco" editable="true" maxWidth="Infinity"
                              promptText="Escolha ou digite" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Pode *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="comboAutTipo" maxWidth="Infinity"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>
                <Label fx:id="labelAvisoFicha" wrapText="true"/>
                <HBox spacing="10">
                    <Button fx:id="botaoAutorizar" text="Autorizar" onAction="#autorizar"
                            styleClass="botao-primario"/>
                </HBox>
            </VBox>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
