<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ficha de anamnese (RF-05, RF-09, RN-10): preenchida para crianças já matriculadas,
     sempre atualizável, com PDF para visualizar e imprimir. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.crechesementinhas.controller.AnamneseController"
            prefWidth="1180" prefHeight="720"
            stylesheets="@estilo.css"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #2e7d32;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Ficha de Anamnese"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar ao menu" onAction="#voltar"
                    style="-fx-background-color: white; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Esquerda: crianças com matrícula ativa -->
    <left>
        <VBox spacing="10" prefWidth="420">
            <padding>
                <Insets top="20" right="10" bottom="20" left="20"/>
            </padding>
            <Label text="Buscar criança matriculada" style="-fx-font-weight: bold;"/>
            <TextField fx:id="campoBusca" promptText="Digite parte do nome"/>
            <TableView fx:id="tabelaMatriculas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaNome" text="Criança" prefWidth="190"/>
                    <TableColumn fx:id="colunaMatricula" text="Matrícula" prefWidth="110"/>
                    <TableColumn fx:id="colunaFicha" text="Ficha" prefWidth="90"/>
                </columns>
            </TableView>
            <Label fx:id="labelTotal" style="-fx-text-fill: #607d8b;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="10"/>
            </padding>

            <!-- Dados que já estão no sistema (nada é digitado de novo) -->
            <GridPane hgap="10" vgap="6"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12;">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Criança" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="labelCrianca" text="Nenhuma criança selecionada" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Nascimento / idade" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="labelNascimento" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Matrícula / turma" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="labelTurma" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Responsáveis" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="labelResponsaveis" text="-" wrapText="true"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Situação da ficha" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="labelSituacao" text="-" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <ScrollPane fx:id="painelFormulario" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;">
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 14;">
                    <Label text="Saúde" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="260" prefWidth="260"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <CheckBox fx:id="checkAlergia" text="Possui alergia?"
                                  GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoAlergia" promptText="Qual(is)? Descreva" maxWidth="Infinity"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkRestricao" text="Possui restrição alimentar?"
                                  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoRestricao" promptText="Qual(is)? Descreva" maxWidth="Infinity"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkProblemas" text="Possui problemas de saúde?"
                                  GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoProblemas" promptText="Qual(is)? Descreva" maxWidth="Infinity"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkMedicacao" text="Usa medicação contínua?"
                                  GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoMedicacao" promptText="Qual medicação, dose e horário" maxWidth="Infinity"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkCirurgia" text="Já fez cirurgia?"
                                  GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoCirurgia" promptText="Qual(is) e quando" maxWidth="Infinity"
                                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkFratura" text="Já teve fraturas?"
                                  GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoFratura" promptText="Onde e quando" maxWidth="Infinity"
                                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Antitérmico autorizado" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoAntitermico" promptText="Nome do remédio e dose (opcional)"
                                   maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Separator/>
                    <Label text="Rotina e autorizações" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="260" prefWidth="260"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <CheckBox fx:id="checkMamadeira" text="Usa mamadeira?"
                                  GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                        <CheckBox fx:id="checkFormula" text="Usa fórmula?"
                                  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoFormula" promptText="Qual fórmula" maxWidth="Infinity"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkChupeta" text="Usa chupeta?"
                                  GridPane.rowIndex="2" GridPane.columnIndex="0"/>

                        <CheckBox fx:id="checkFralda" text="Usa fralda?"
                                  GridPane.rowIndex="3" GridPane.columnIndex="0"/>

                        <CheckBox fx:id="checkImagem" text="Autoriza o uso de imagem?"
                                  GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    </GridPane>

                    <Separator/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="260" prefWidth="260"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label fx:id="rotuloJustificativa" text="Motivo da atualização (opcional)"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoJustificativa" promptText="Aparece no histórico de alterações"
                                   maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>

            <Label fx:id="labelMensagem" wrapText="true" visible="false" managed="false"/>

            <HBox spacing="10">
                <Button fx:id="botaoSalvar" text="Salvar ficha" onAction="#salvar"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="botaoVisualizar" text="Visualizar / imprimir PDF" onAction="#visualizarPdf"
                        style="-fx-background-color: white; -fx-text-fill: #2e7d32; -fx-border-color: #2e7d32;"/>
                <Button fx:id="botaoSalvarPdf" text="Salvar PDF como..." onAction="#salvarPdf"
                        style="-fx-background-color: white; -fx-text-fill: #2e7d32; -fx-border-color: #2e7d32;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
