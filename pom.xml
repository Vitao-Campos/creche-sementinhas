<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Identidade do projeto: "endereço" único dele no mundo Maven -->
    <groupId>br.com.crechesementinhas</groupId>
    <artifactId>creche-sementinhas</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- Variáveis reutilizáveis: mudar a versão aqui muda em todo o arquivo -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.5</javafx.version>
    </properties>

    <!-- Bibliotecas que o Maven baixa automaticamente -->
    <dependencies>
        <!-- Componentes de tela: botões, campos de texto, tabelas -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Testes unitários -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>

        <!-- Permite desenhar as telas em arquivos .fxml (Scene Builder) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Driver JDBC: a "ponte" entre o Java e o PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
        </dependency>
        
                <!-- BCrypt: verificação e geração de hash de senhas (RNF-01) -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

                <!-- Contrato: gera o contrato em PDF (RF-09) -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.0.3</version>
        </dependency>
    </dependencies>

    <build>
            <!-- Nome do jar gerado: creche-sementinhas.jar (sem o número da versão) -->
        <finalName>creche-sementinhas</finalName>
        <plugins>
            <!-- Plugin que executa a aplicação com: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>br.com.crechesementinhas.App</mainClass>
                </configuration>
            </plugin>
                        <!-- Monta o executável: um único jar com o sistema e todas as bibliotecas -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Define a classe que inicia o sistema ao dar dois cliques -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.com.crechesementinhas.Launcher</mainClass>
                                </transformer>
                                <!-- Mantém o registro do driver JDBC do PostgreSQL -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Assinaturas das bibliotecas: invalidariam o jar reempacotado -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!-- Segurança: a senha do banco NÃO vai dentro do jar -->
                                        <exclude>db.properties</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>